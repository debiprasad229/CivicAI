# CivicAI Frontend Environment Variables (Vercel / Production)

# Backend API Base URL (points to your deployed Render web service with /api suffix)
VITE_API_URL=https://your-civicai-backend.onrender.com/api

# Geoapify API Key for Leaflet interactive map tiles & geocoding (free at https://myprojects.geoapify.com)
VITE_GEOAPIFY_API_KEY=your_geoapify_api_key_here
