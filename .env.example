# CivicAI Vercel Serverless Environment Variables
# Configure these variables directly in your Vercel Dashboard under Settings > Environment Variables

# ===================================================
# 1. Database & Security (Serverless API)
# ===================================================
NODE_ENV=production
MONGO_URI=mongodb+srv://<db_username>:<db_password>@<cluster-address>.mongodb.net/civicai?retryWrites=true&w=majority
JWT_SECRET=your_jwt_secret_key_minimum_32_characters_long

# ===================================================
# 2. AI Engine (Google Gemini API)
# ===================================================
GEMINI_API_KEY=your_gemini_api_key_from_google_ai_studio

# ===================================================
# 3. GIS / Mapping (Geoapify)
# ===================================================
VITE_GEOAPIFY_API_KEY=your_geoapify_api_key_here
GEOAPIFY_API_KEY=your_geoapify_api_key_here
