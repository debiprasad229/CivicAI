# CivicAI Root Environment Variables Overview
# For deployments, configure these variables in Render (Backend) and Vercel (Frontend) respectively.

# ==========================================
# BACKEND (Render Web Service Environment)
# ==========================================
PORT=5000
NODE_ENV=production
MONGO_URI=mongodb+srv://<db_username>:<db_password>@<cluster-address>.mongodb.net/civicai?retryWrites=true&w=majority
JWT_SECRET=your_jwt_secret_key_minimum_32_characters_long
GEMINI_API_KEY=your_gemini_api_key_from_google_ai_studio
CLIENT_URL=https://your-civicai-app.vercel.app
GEOAPIFY_API_KEY=your_geoapify_api_key_here

# ==========================================
# FRONTEND (Vercel Project Environment)
# ==========================================
VITE_API_URL=https://your-civicai-backend.onrender.com/api
VITE_GEOAPIFY_API_KEY=your_geoapify_api_key_here
