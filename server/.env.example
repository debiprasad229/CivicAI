# CivicAI Backend Environment Variables (Render / Production)
PORT=5000
NODE_ENV=production

# MongoDB Atlas Connection URI (replace with your Atlas credentials and cluster name)
MONGO_URI=mongodb+srv://<db_username>:<db_password>@<cluster-address>.mongodb.net/civicai?retryWrites=true&w=majority

# JWT Secret for user & admin session token signing (generate using openssl rand -hex 32)
JWT_SECRET=your_jwt_secret_key_minimum_32_characters_long

# Google Gemini API Key (obtain from https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=your_gemini_api_key_here

# Frontend Application Origin (used for CORS; supports comma-separated URLs or *.vercel.app)
CLIENT_URL=https://your-civicai-app.vercel.app

# Geoapify API Key (optional server-side geocoding fallback)
GEOAPIFY_API_KEY=your_geoapify_api_key_here
